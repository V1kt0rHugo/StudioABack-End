// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELED
}

enum StockAdjustmentType {
  LOSS
  DAMAGE
  EXPIRATION
  AUDIT
  CORRECTION
}

enum Role {
  MANAGER
  PROFESSIONAL
}

model Client {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  password         String
  phone            String?
  birthDate        DateTime?
  notes            String?
  isEmailVerified  Boolean           @default(false)
  verificationCode String?
  createdAt        DateTime          @default(now())
  CustomerServices CustomerService[]
  Anamneses        ClientAnamnesis[]
  Packages         ClientPackage[]
  Orders           Order[]
}

model ClientAnamnesis {
  id              String   @id @default(uuid())
  idClient        String
  Client          Client   @relation(fields: [idClient], references: [id])
  notes           String?
  allergies       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ClientPackage {
  id             String   @id @default(uuid())
  idClient       String
  Client         Client   @relation(fields: [idClient], references: [id])
  idService      String
  Service        Services @relation(fields: [idService], references: [id])
  totalQuantity  Int
  usedQuantity   Int      @default(0)
  expirationDate DateTime?
  createdAt      DateTime @default(now())
}

model Employee {
  id                   String                @id @default(uuid())
  name                 String
  email                String                @unique
  password             String
  CPF                  String                @unique
  phone                String
  commissionPercentage Float
  role                 Role                  @default(PROFESSIONAL)
  PerformedServices    PerformedServices[]
  ServiceConfigs       EmployeeServiceConfig[]
  Schedules            EmployeeSchedule[]
  CashTransactions     CashFlowTransaction[]
}

model EmployeeServiceConfig {
  id               String   @id @default(uuid())
  idEmployee       String
  Employee         Employee @relation(fields: [idEmployee], references: [id])
  idService        String
  Service          Services @relation(fields: [idService], references: [id])
  customPrice      Float?
  customDuration   Int?
  customCommission Float?
  
  @@unique([idEmployee, idService])
}

model CustomerService {
  id                String               @id @default(uuid())
  idClient          String
  Client            Client               @relation(fields: [idClient], references: [id])
  Status            ServiceStatus        @default(SCHEDULED)
  Date              DateTime
  EndTime           DateTime
  TotalValue        Float
  idOrder           String?
  Order             Order?               @relation(fields: [idOrder], references: [id])
  ConsumedItems     ConsumedItems[]
  PerformedServices PerformedServices[]
  CashTransaction   CashFlowTransaction?
  clientFeedback    String?
  cancellationReason String?
}

model Order {
  id               String               @id @default(uuid())
  idClient         String
  Client           Client               @relation(fields: [idClient], references: [id])
  date             DateTime             @default(now())
  status           OrderStatus          @default(OPEN)
  totalValue       Float                @default(0)
  CustomerServices CustomerService[]
  ProductSales     ProductSale[]
  Payments         OrderPayment[]
  CashTransactions CashFlowTransaction[]
}

model OrderPayment {
  id            String        @id @default(uuid())
  idOrder       String
  Order         Order         @relation(fields: [idOrder], references: [id])
  amount        Float
  paymentMethod PaymentMethod
  date          DateTime      @default(now())
}

model ProductSale {
  id        String   @id @default(uuid())
  idOrder   String
  Order     Order    @relation(fields: [idOrder], references: [id])
  idProduct String
  Product   Products @relation(fields: [idProduct], references: [id])
  quantity  Int
  price     Float
}

model Products {
  id            String          @id @default(uuid())
  name          String
  price         Float
  brand         String
  stock         Float
  minStock      Float?          @default(0)
  totalVolume   Float?
  volumePerUnit Float?
  unit          String?
  ConsumedItems ConsumedItems[]
  Batches       ProductBatch[]
  Adjustments   StockAdjustment[]
  Sales         ProductSale[]
}

model ProductBatch {
  id             String    @id @default(uuid())
  idProduct      String
  Product        Products  @relation(fields: [idProduct], references: [id])
  batchNumber    String
  expirationDate DateTime?
  quantity       Float
}

model StockAdjustment {
  id        String              @id @default(uuid())
  idProduct String
  Product   Products            @relation(fields: [idProduct], references: [id])
  quantity  Float
  type      StockAdjustmentType
  reason    String?
  date      DateTime            @default(now())
}

model Services {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  price              Float
  estimatedDuration  Int                 @default(30)
  returnDaysReminder Int?                @default(0)
  PerformedServices  PerformedServices[]
  EmployeeConfigs    EmployeeServiceConfig[]
  ClientPackages     ClientPackage[]
}

model PerformedServices {
  id                   String          @id @default(uuid())
  idCustomerService    String
  CustomerService      CustomerService @relation(fields: [idCustomerService], references: [id])
  idService            String
  Service              Services        @relation(fields: [idService], references: [id])
  idEmployee           String
  Employee             Employee        @relation(fields: [idEmployee], references: [id])
  priceCharged         Float
  commissionPercentage Float
  commissionValue      Float
  isCommissionPaid     Boolean         @default(false)
  commissionPaidAt     DateTime?
}

model ConsumedItems {
  id                String          @id @default(uuid())
  idCustomerService String
  CustomerService   CustomerService @relation(fields: [idCustomerService], references: [id])
  idProduct         String
  Products          Products        @relation(fields: [idProduct], references: [id])
  usedQuantity      Float
}

model EmployeeSchedule {
  id         String   @id @default(uuid())
  employeeId String
  Employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  date       String?
  startTime  String
  endTime    String
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  SERVICO_PRESTADO
  VENDA_PRODUTO
  PAGAMENTO_COMISSAO
  COMPRA_INSUMOS
  ALUGUEL
  AGUA_LUZ
  MARKETING
  SALARIO
  OUTROS
}

enum TransactionStatus {
  PAID
  PENDING
  CANCELED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  TRANSFER
}

model CashFlowTransaction {
  id                String               @id @default(uuid())
  type              TransactionType
  description       String
  amount            Float
  paymentMethod     PaymentMethod?
  category          TransactionCategory?
  status            TransactionStatus    @default(PAID)
  dueDate           DateTime?
  paymentDate       DateTime?
  date              DateTime             @default(now())
  idCustomerService String?              @unique
  CustomerService   CustomerService?     @relation(fields: [idCustomerService], references: [id])
  idOrder           String?
  Order             Order?               @relation(fields: [idOrder], references: [id])
  idEmployee        String?
  Employee          Employee?            @relation(fields: [idEmployee], references: [id])
}
